GC_LobbyGameMode : "{9B42B808F4E97C4D}Prefabs/MP/Modes/GameMode_Lobby.et" {
 ID "6A4D100000000011"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_BriefingCatalog GC_LobbyBriefingCatalog "{6A4D100000000012}" {
    m_aBriefings {
     GC_Briefing "{6A42000000000015}" {
      m_iOrder 1
      m_sTitle "SCENARIO"
      m_sContent "<scenario />"
     }
     GC_Briefing "{6A42000000000001}" {
      m_iOrder 2
      m_sTitle "RICH TEXT SHOWCASE"
      m_sContent "<p>Assault and secure key positions across the area of operations to establish control and degrade enemy capabilities. To test the briefing action, <action id=\"debug_print\"><color rgba=\"255,0,255,255\"><b>click the action here</b></color></action> and watch the Workbench console.</p><p>Both sides have established strong defensive positions. Expect contact throughout the area.</p><p>Civilian activity is minimal. Maintain mission focus and minimize collateral damage.</p><br /><color rgba=\"255,152,50,255\"><b>KEY INFORMATION</b></color><br /><color rgba=\"150,160,164,255\">AREA OF OPERATIONS</color><br />Everon, Baltic Sea<br /><br /><color rgba=\"150,160,164,255\">EST. DURATION</color><br />60 minutes<br /><br /><color rgba=\"150,160,164,255\">VICTORY CONDITION</color><br />Complete the assigned objectives and preserve friendly combat power."
     }
     GC_Briefing "{6A42000000000002}" {
      m_iOrder 3
      m_sTitle "SITUATION"
      m_sContent "<p><img resource=\"{CDE4B2BF08F5EA5F}UI/Textures/InventoryIcons/InvenorySlot-Primary_UI.edds\" inline=\"true\" height=\"24\" /> Enemy forces control several strategically important positions and are prepared to reinforce them. Map focus can reference <marker name=\"marker2\"><color name=\"orange\"><b>marker Alpha</b></color></marker> by its entity name. Reference: <link url=\"https://community.bistudio.com/wiki/Arma_Reforger\"><b>Arma Reforger Wiki</b></link>.</p><p>Friendly elements are assembling in protected staging areas. Reconnaissance is limited, so unit leaders should confirm routes before movement.</p><br /><color rgba=\"255,152,50,255\"><b>COMMANDER'S NOTE</b></color><br />Maintain communications, identify targets before engagement, and report meaningful changes in enemy disposition."
     }
     GC_Briefing "{6A42000000000003}" {
      m_iOrder 4
      m_sTitle "MISSION"
      m_sContent "<p>Formatting proof: <u><b>bold underline</b></u>, <s><i>italic strikethrough</i></s>, and <size scale=\"1.35\"><u><color name=\"orange\">larger orange underline</color></u></size>.</p><p>Friendly forces will seize the designated objectives, prevent an organized enemy counterattack, and establish control of the area.</p><p>Leaders retain freedom of maneuver within their assigned tasks. Coordinate supporting fires and avoid isolating individual groups.</p><br /><color rgba=\"255,152,50,255\"><b>END STATE</b></color><br />All required objectives are secure, enemy combat effectiveness is reduced, and friendly forces are prepared for follow-on operations."
     }
     GC_Briefing "{6A42000000000004}" {
      m_iOrder 5
      m_sTitle "OBJECTIVES"
      m_sContent "<color rgba=\"255,152,50,255\"><b>PRIMARY OBJECTIVES</b></color><br /><br /><b>01</b>  Secure the assigned area of operations.<br /><br /><b>02</b>  Disrupt enemy command and reinforcement routes.<br /><br /><b>03</b>  Retain sufficient combat power to hold captured positions.<br /><br /><color rgba=\"150,160,164,255\">Additional objectives may be issued by mission leadership as the situation develops.</color>"
     }
     GC_Briefing "{6A42000000000005}" {
      m_iOrder 6
      m_sTitle "EXECUTION PLAN"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 05</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><img resource=\"{CDE4B2BF08F5EA5F}UI/Textures/InventoryIcons/InvenorySlot-Primary_UI.edds\" width=\"420\" height=\"180\" /><img resource=\"{CB9C19A2219A4BFC}UI/Textures/Icons/Lobby_PS_Atlas_x64.imageset\" name=\"Attention\" width=\"96\" height=\"96\" /><b>PHASE ONE</b><br />Move from the staging area using covered routes.<br />Confirm every element is present before crossing the departure line.<br />Report delays, route obstructions, and changes in enemy activity.<br /><br /><b>PHASE TWO</b><br />Establish observation over the assigned sector.<br />Maintain dispersion while supporting adjacent teams.<br />Coordinate movement before entering exposed terrain.<br /><br /><b>PHASE THREE</b><br />Secure the primary position and establish local security.<br />Mark cleared approaches and identify suitable casualty collection points.<br />Preserve sufficient combat power for follow-on tasks.<br /><br /><b>COORDINATION</b><br />Use concise reports and acknowledge all changes to the plan.<br />Keep supporting elements informed of friendly positions.<br />Avoid masking adjacent sectors during movement.<br /><br /><b>SUSTAINMENT</b><br />Conserve ammunition until confirmed contact.<br />Redistribute critical equipment before continuing the advance.<br />Report medical and transport requirements immediately.<br /><br /><b>END STATE</b><br />All assigned positions are secure.<br />Friendly elements remain mutually supporting.<br />The force is prepared to continue operations."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A42000000000006}" {
      m_iOrder 7
      m_sTitle "SERVICE SUPPORT"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 06</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>SUPPLY</b><br />Confirm ammunition, medical stores, and specialist equipment before movement.<br />Identify the primary and alternate resupply points.<br />Maintain accountability for mission-essential equipment.<br /><br /><b>TRANSPORT</b><br />Stage vehicles under cover and preserve clear exit routes.<br />Assign recovery priorities before the operation begins.<br />Report disabled vehicles without delaying the maneuver element.<br /><br /><b>MEDICAL</b><br />Establish casualty collection points near protected routes.<br />Pass accurate casualty numbers and evacuation requirements.<br />Keep treatment areas separated from ammunition transfer points.<br /><br /><b>RECOVERY</b><br />Mark damaged equipment that cannot be moved immediately.<br />Coordinate security before dispatching recovery assets.<br />Preserve routes for follow-on traffic.<br /><br /><b>CONTINUITY</b><br />Maintain reserve supplies for unexpected delays.<br />Update leaders when consumption exceeds the planned rate.<br />Prepare alternate distribution methods if routes are blocked.<br /><br /><b>END STATE</b><br />The force remains supplied and mobile.<br />Casualties are stabilized and evacuated.<br />Critical equipment is available for continued operations."
      m_eShowAtGameModeState PREGAME
     }
     GC_Briefing "{6A42000000000007}" {
      m_iOrder 8
      m_sTitle "COMMAND AND SIGNAL"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 07</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>COMMAND</b><br />Leaders remain with the elements that require the closest coordination.<br />Succession of command follows the published team order.<br />Report any loss of command capability immediately.<br /><br /><b>PRIMARY NETWORK</b><br />Use the assigned command channel for orders and reports.<br />Keep transmissions brief during contact.<br />Acknowledge changes that affect adjacent elements.<br /><br /><b>ALTERNATE NETWORK</b><br />Shift to the alternate channel when directed.<br />Use runners or visual signals if radio contact cannot be restored.<br />Avoid transmitting sensitive details on unsecured channels.<br /><br /><b>REPORTING</b><br />Send position reports at phase transitions.<br />Report enemy strength, direction, and activity.<br />Confirm objective status before requesting follow-on instructions.<br /><br /><b>SIGNALS</b><br />Use marked signals only for their assigned purpose.<br />Repeat emergency signals when conditions permit.<br />Ensure every team understands the recognition plan.<br /><br /><b>END STATE</b><br />Command relationships remain clear.<br />All elements can exchange essential information.<br />The force can continue despite local communications failures."
      m_eShowAtGameModeState BRIEFING
     }
     GC_Briefing "{6A42000000000008}" {
      m_iOrder 9
      m_sTitle "INTELLIGENCE SUMMARY AND THREAT ASSESSMENT"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 08</b></color><br /><br />This briefing is intentionally oversized and its long title also tests single-line title shrinking in the briefing index.<br /><br /><b>ENEMY DISPOSITION</b><br />Small defensive elements occupy key terrain and likely avenues of approach.<br />Reserve forces may move after friendly contact is confirmed.<br />Prepared positions should be expected near major intersections.<br /><br /><b>CAPABILITIES</b><br />Enemy teams can delay movement with direct fire and obstacles.<br />Indirect support may be available with limited warning.<br />Mobile patrols can exploit gaps between friendly elements.<br /><br /><b>LIMITATIONS</b><br />Enemy observation is reduced in broken terrain.<br />Command links appear dependent on a small number of relay positions.<br />Sustained operations may strain local ammunition stocks.<br /><br /><b>INDICATORS</b><br />Increased vehicle movement may signal reinforcement.<br />Radio silence may precede displacement or counterattack.<br />Abandoned checkpoints may conceal observation teams.<br /><br /><b>COLLECTION</b><br />Confirm routes, obstacles, and occupied positions.<br />Record movement direction and approximate strength.<br />Pass time-sensitive observations without delay.<br /><br /><b>ASSESSMENT</b><br />The enemy is capable of organized local resistance.<br />Rapid coordination will reduce its ability to concentrate.<br />Maintain security after each objective is cleared."
      m_eShowAtGameModeState PREGAME
     }
     GC_Briefing "{6A42000000000009}" {
      m_iOrder 10
      m_sTitle "ROUTE PLAN"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 09</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>PRIMARY ROUTE</b><br />Follow terrain that limits observation from the objective area.<br />Maintain interval at choke points and exposed crossings.<br />Do not halt the entire column inside restricted terrain.<br /><br /><b>ALTERNATE ROUTE</b><br />Use the alternate route if the primary route is blocked or observed.<br />Confirm the lead element has cleared each control measure.<br />Report significant delays before committing follow-on elements.<br /><br /><b>DANGER AREAS</b><br />Cross open ground one element at a time.<br />Establish overwatch before entering narrow approaches.<br />Mark obstacles that cannot be bypassed quickly.<br /><br /><b>CONTROL POINTS</b><br />Confirm passage at each numbered checkpoint.<br />Use rally points to restore organization after contact.<br />Keep casualty and recovery traffic clear of the advance route.<br /><br /><b>RETURN ROUTE</b><br />Preserve an unobstructed route to the support area.<br />Update the route plan if terrain conditions change.<br />Account for every element before displacement.<br /><br /><b>END STATE</b><br />All teams arrive in sequence.<br />Routes remain available for support traffic.<br />The force retains freedom of maneuver."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A4200000000000A}" {
      m_iOrder 11
      m_sTitle "FIRE SUPPORT"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 10</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>PRIORITIES</b><br />Support the main effort during movement and consolidation.<br />Suppress confirmed threats that prevent maneuver.<br />Preserve capability for the expected counterattack window.<br /><br /><b>CONTROL</b><br />Confirm target location and friendly positions before engagement.<br />Use established control measures for every request.<br />Cancel missions when effects are no longer required.<br /><br /><b>OBSERVATION</b><br />Position observers with redundant communications.<br />Maintain visibility of likely enemy approaches.<br />Pass corrections clearly and without unnecessary delay.<br /><br /><b>RESTRICTIONS</b><br />Avoid fires near protected structures and civilian routes.<br />Respect the boundaries assigned to adjacent elements.<br />Use the minimum effect required to support movement.<br /><br /><b>CONTINGENCIES</b><br />Shift priority when the reserve is committed.<br />Prepare smoke to cover casualty evacuation or displacement.<br />Report unavailable systems immediately.<br /><br /><b>END STATE</b><br />Friendly maneuver is supported throughout the operation.<br />Critical threats are suppressed at the required time.<br />Sufficient support remains for follow-on tasks."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A4200000000000B}" {
      m_iOrder 12
      m_sTitle "MEDICAL PLAN"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 11</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>POINT OF INJURY</b><br />Apply immediate care and establish local security.<br />Send a concise casualty report as soon as conditions permit.<br />Move casualties only when the route is protected.<br /><br /><b>COLLECTION</b><br />Use the nearest designated casualty collection point.<br />Separate walking wounded from urgent evacuation cases.<br />Maintain accountability for casualties and escorts.<br /><br /><b>EVACUATION</b><br />Confirm pickup location, route, and security status.<br />Mark the site using the approved signal.<br />Keep the evacuation lane clear of unnecessary vehicles.<br /><br /><b>TREATMENT</b><br />Prioritize life-threatening conditions.<br />Record treatment and evacuation time.<br />Request additional supplies before stocks become critical.<br /><br /><b>CONTINGENCIES</b><br />Use the alternate collection point if the primary is compromised.<br />Prepare ground evacuation when air movement is unavailable.<br />Coordinate security for every recovery attempt.<br /><br /><b>END STATE</b><br />Casualties receive timely care.<br />Evacuation routes remain protected.<br />The maneuver force retains adequate medical support."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A4200000000000C}" {
      m_iOrder 13
      m_sTitle "RULES OF ENGAGEMENT"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 12</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>POSITIVE IDENTIFICATION</b><br />Confirm hostile intent before engagement.<br />Use available optics and reports to reduce uncertainty.<br />Do not engage solely on movement or location.<br /><br /><b>PROPORTIONALITY</b><br />Apply only the force required to remove the threat.<br />Stop engagement when the threat is no longer present.<br />Consider nearby friendly and civilian activity.<br /><br /><b>PROTECTED AREAS</b><br />Avoid damage to marked medical and civilian locations.<br />Report activity near protected sites.<br />Request clarification when status is uncertain.<br /><br /><b>DETENTION</b><br />Disarm, search, and secure detained personnel.<br />Provide necessary medical care.<br />Transfer custody through the designated chain.<br /><br /><b>REPORTING</b><br />Report significant engagements and unusual incidents.<br />Preserve relevant observations for follow-up.<br />Escalate uncertainty before taking irreversible action.<br /><br /><b>END STATE</b><br />Threats are addressed lawfully and effectively.<br />Protected persons and locations remain safeguarded.<br />The force retains freedom to complete its mission."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A4200000000000D}" {
      m_iOrder 14
      m_sTitle "CIVIL CONSIDERATIONS"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 13</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>POPULATION</b><br />Civilian movement may continue near major roads and settlements.<br />Expect incomplete information about local conditions.<br />Use interpreters or designated contacts where available.<br /><br /><b>INFRASTRUCTURE</b><br />Preserve utilities, medical facilities, and essential routes.<br />Report damage that may affect the population.<br />Avoid blocking emergency access points.<br /><br /><b>DISPLACEMENT</b><br />Keep civilians away from active fighting and military positions.<br />Identify safe directions of movement.<br />Coordinate temporary control measures with mission leadership.<br /><br /><b>INFORMATION</b><br />Provide clear instructions without revealing operational details.<br />Correct dangerous rumors when practical.<br />Document requests that require higher approval.<br /><br /><b>INCIDENTS</b><br />Report civilian injuries and property damage promptly.<br />Preserve evidence when conditions permit.<br />Treat all persons with dignity and consistency.<br /><br /><b>END STATE</b><br />Civilian harm is minimized.<br />Essential services remain usable.<br />The mission retains local freedom of action."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A4200000000000E}" {
      m_iOrder 15
      m_sTitle "WEATHER AND TERRAIN"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 14</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>VISIBILITY</b><br />Low ground and vegetation restrict long-range observation.<br />Changing light may expose movement on open slopes.<br />Use covered positions for prolonged halts.<br /><br /><b>GROUND</b><br />Soft shoulders may not support heavy vehicles.<br />Drainage features can slow dismounted movement.<br />Confirm crossing points before committing support assets.<br /><br /><b>KEY TERRAIN</b><br />High ground dominates the primary approaches.<br />Road junctions control rapid movement between sectors.<br />Wood lines provide concealment but restrict mutual support.<br /><br /><b>WEATHER</b><br />Rain may reduce traction and sensor effectiveness.<br />Wind can affect smoke and exposed equipment.<br />Protect sensitive supplies during extended halts.<br /><br /><b>MOBILITY</b><br />Keep alternate routes available.<br />Avoid concentrating vehicles at narrow crossings.<br />Report terrain changes that affect follow-on elements.<br /><br /><b>END STATE</b><br />Terrain advantages are used deliberately.<br />Weather effects are anticipated.<br />The force avoids preventable mobility losses."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A4200000000000F}" {
      m_iOrder 16
      m_sTitle "CONTINGENCIES"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 15</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>EARLY CONTACT</b><br />Establish security and identify the threat before committing reserves.<br />Move vulnerable support assets away from the contact area.<br />Report whether the route remains usable.<br /><br /><b>ROUTE BLOCKED</b><br />Halt outside the danger area.<br />Reconnoiter the alternate route before redirecting the column.<br />Mark the obstruction for follow-on elements.<br /><br /><b>LOSS OF COMMUNICATIONS</b><br />Continue to the last confirmed control measure.<br />Attempt the alternate channel and designated visual signals.<br />Dispatch a messenger only along a protected route.<br /><br /><b>COUNTERATTACK</b><br />Hold key terrain and restore mutual support.<br />Commit the reserve against the most dangerous penetration.<br />Request supporting effects early.<br /><br /><b>MISSION CHANGE</b><br />Acknowledge the new task and clarify essential constraints.<br />Reorganize before moving when time permits.<br />Inform adjacent elements of altered boundaries.<br /><br /><b>END STATE</b><br />The force responds without losing cohesion.<br />Critical tasks remain covered.<br />Leaders retain options as conditions change."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A42000000000010}" {
      m_iOrder 17
      m_sTitle "REHEARSAL NOTES"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 16</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>SEQUENCE</b><br />Review movement from staging through consolidation.<br />Confirm the expected order of each team.<br />Identify actions that require a leader decision.<br /><br /><b>CONTROL MEASURES</b><br />Point out routes, checkpoints, boundaries, and rally points.<br />Ensure every element recognizes the objective limits.<br />Clarify where support assets will operate.<br /><br /><b>COMMUNICATIONS</b><br />Test primary and alternate channels.<br />Practice reports required at each phase line.<br />Confirm signals for emergency displacement.<br /><br /><b>CASUALTIES</b><br />Walk through treatment, collection, and evacuation steps.<br />Assign personnel to replace key casualties.<br />Confirm routes to each collection point.<br /><br /><b>CONTINGENCIES</b><br />Rehearse early contact and blocked-route responses.<br />Practice transition to the alternate command plan.<br />Resolve conflicts before final inspection.<br /><br /><b>END STATE</b><br />Every participant understands the sequence.<br />Critical coordination points are confirmed.<br />The force is ready to execute without additional explanation."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A42000000000011}" {
      m_iOrder 18
      m_sTitle "SECURITY PLAN"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 17</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>LOCAL SECURITY</b><br />Assign observation in every likely direction of approach.<br />Use covered positions and avoid predictable patterns.<br />Maintain contact with adjacent elements.<br /><br /><b>HALTS</b><br />Establish security before administrative activity begins.<br />Keep weapons oriented toward assigned sectors.<br />Limit unnecessary movement and light.<br /><br /><b>ACCESS CONTROL</b><br />Challenge unknown personnel before allowing approach.<br />Keep entry points visible and mutually supported.<br />Report suspicious activity without delay.<br /><br /><b>INFORMATION SECURITY</b><br />Share operational details only with personnel who require them.<br />Secure maps, devices, and written notes.<br />Report lost equipment immediately.<br /><br /><b>DISPLACEMENT</b><br />Maintain security until the final element departs.<br />Check positions for sensitive material.<br />Use alternate routes when observation is suspected.<br /><br /><b>END STATE</b><br />The force avoids surprise.<br />Information and equipment remain protected.<br />Security supports continuous mission activity."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A42000000000012}" {
      m_iOrder 19
      m_sTitle "CONSOLIDATION"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 18</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>SECURITY</b><br />Occupy positions that cover likely enemy approaches.<br />Establish contact with adjacent elements.<br />Prepare for immediate counterattack.<br /><br /><b>ACCOUNTABILITY</b><br />Confirm personnel, casualties, equipment, and ammunition.<br />Report missing elements and unresolved contact.<br />Update the command post with current strength.<br /><br /><b>REORGANIZATION</b><br />Replace key leaders and redistribute essential equipment.<br />Move casualties to protected collection points.<br />Replenish teams according to priority.<br /><br /><b>PREPARATION</b><br />Improve fighting positions without losing observation.<br />Mark cleared lanes and dangerous areas.<br />Prepare alternate and supplementary positions.<br /><br /><b>REPORTING</b><br />Confirm objective status and enemy activity.<br />Submit ammunition and medical requirements.<br />Request instructions for follow-on tasks.<br /><br /><b>END STATE</b><br />The objective is secure.<br />The force is reorganized and mutually supporting.<br />Leaders are prepared for the next mission."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A42000000000013}" {
      m_iOrder 20
      m_sTitle "FOLLOW-ON OPERATIONS"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 19</b></color><br /><br />This briefing is intentionally oversized so the document reaches its maximum height and enables scrolling.<br /><br /><b>READINESS</b><br />Restore ammunition, medical supplies, and communications.<br />Confirm the status of vehicles and specialist equipment.<br />Replace critical personnel where possible.<br /><br /><b>INFORMATION</b><br />Update maps with confirmed enemy and friendly positions.<br />Pass lessons that affect the next movement.<br />Identify unresolved threats around the objective.<br /><br /><b>PLANNING</b><br />Review likely routes and control measures.<br />Assign provisional tasks to available elements.<br />Preserve a reserve for unexpected requirements.<br /><br /><b>COORDINATION</b><br />Confirm boundaries with adjacent forces.<br />Arrange support before displacement begins.<br />Publish changes to command and signal procedures.<br /><br /><b>TRANSITION</b><br />Maintain security while teams prepare to move.<br />Transfer responsibility using a clear handover.<br />Account for every element before departure.<br /><br /><b>END STATE</b><br />The force can transition without losing security.<br />Support and command relationships remain intact.<br />All elements understand the next likely task."
      m_eShowAtGameModeState GAME
     }
     GC_Briefing "{6A42000000000014}" {
      m_iOrder 21
      m_sTitle "FINAL SCROLL VALIDATION ENTRY"
      m_sContent "<color name=\"orange\"><b>SCROLL TEST BODY 20</b></color><br /><br />This final briefing verifies that the list can reach entry twenty and that the document body remains scrollable at maximum height.<br /><br /><b>LIST CHECK</b><br />Scroll from the first briefing to this final entry.<br />Confirm each two-digit order remains aligned.<br />Confirm long titles shrink instead of moving the order column.<br /><br /><b>SELECTION CHECK</b><br />Select this entry after scrolling the list.<br />Close the document and reopen it.<br />Confirm the same content is visible on every open.<br /><br /><b>BODY CHECK</b><br />Scroll from this heading to the final line.<br />Confirm the document panel does not grow beyond its maximum height.<br />Confirm the map does not zoom while the pointer is over the document.<br /><br /><b>OVERFLOW CHECK</b><br />Verify the overflow indicator appears while more content remains.<br />Move to the bottom and confirm the indicator clears.<br />Return to the top and repeat the test.<br /><br /><b>REGRESSION CHECK</b><br />Select a short original briefing and compare panel height.<br />Select another oversized briefing and compare its maximum height.<br />Repeat selections to check for one-frame flexing.<br /><br /><b>COMPLETE</b><br />Entry twenty is reachable.<br />The title list and document body both scroll independently.<br />The briefing interface remains stable through repeated selection."
      m_eShowAtGameModeState GAME
     }
    }
   }
   m_ParameterCatalog GC_LobbyParameterCatalog "{6A4D100000000015}" {
    m_aDefinitions {
     GC_LobbyBoolParameterDefinition "{6A4D100000000020}" {
      m_sLabel "ENABLE REINFORCEMENTS"
      m_sDescription "Allow the scenario to use reinforcement behavior."
      m_sOwnerFactionKey "US"
      m_bDefaultValue 1
     }
     GC_LobbyIntegerParameterDefinition "{6A4D100000000021}" {
      m_sLabel "REINFORCEMENT DELAY"
      m_sDescription "Delay in seconds before reinforcement behavior is available."
      m_sOwnerFactionKey "US"
      m_iDefaultValue 300
      m_iMinimum 0
      m_iMaximum 900
      m_iStep 30
      m_ePresentation SLIDER
     }
     GC_LobbyIntegerParameterDefinition "{6A4D100000000027}" {
      m_sLabel "PATROL COUNT"
      m_sDescription "Editable integer example for future scenario logic."
      m_sOwnerFactionKey "US"
      m_iDefaultValue 4
      m_iMinimum 0
      m_iMaximum 16
      m_iStep 1
      m_ePresentation EDIT_BOX
     }
     GC_LobbyIntegerParameterDefinition "{6A4D100000000028}" {
      m_sLabel "RESERVE COUNT"
      m_sDescription "Spin-box integer example for future scenario logic."
      m_sOwnerFactionKey "US"
      m_iDefaultValue 2
      m_iMinimum 0
      m_iMaximum 8
      m_iStep 1
      m_ePresentation SPIN_BOX
     }
     GC_LobbyFloatParameterDefinition "{6A4D100000000022}" {
      m_sLabel "WEATHER INTENSITY"
      m_sDescription "Future slice input for weather control."
      m_sOwnerFactionKey "US"
      m_fDefaultValue 0.5
      m_fMinimum 0
      m_fMaximum 1
      m_fStep 0.1
      m_ePresentation SLIDER
     }
     GC_LobbyFloatParameterDefinition "{6A4D100000000029}" {
      m_sLabel "VISIBILITY DISTANCE"
      m_sDescription "Editable float example for future scenario logic."
      m_sOwnerFactionKey "US"
      m_fDefaultValue 1000
      m_fMinimum 0
      m_fMaximum 5000
      m_fStep 100
      m_ePresentation EDIT_BOX
     }
     GC_LobbyStringParameterDefinition "{6A4D100000000023}" {
      m_sLabel "OPERATION CODENAME"
      m_sDescription "Future slice input for scenario script selection."
      m_sOwnerFactionKey "US"
      m_sDefaultValue "SILENT THUNDER"
      m_iMaximumLength 64
     }
     GC_LobbySelectionParameterDefinition "{6A4D100000000024}" {
      m_sLabel "OPERATION VARIANT"
      m_sDescription "Stable option key for future scenario logic."
      m_sOwnerFactionKey "US"
      m_sDefaultKey "standard"
      m_aOptions {
       GC_LobbyParameterOption "{6A4D100000000025}" {
        m_sLabel "STANDARD"
        m_sKey "standard"
        m_sPayload "variant.standard"
       }
       GC_LobbyParameterOption "{6A4D100000000026}" {
        m_sLabel "HIGH INTENSITY"
        m_sKey "high_intensity"
        m_sPayload "variant.high_intensity"
       }
