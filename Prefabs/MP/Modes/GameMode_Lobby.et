   m_aBriefings {
    GC_Briefing "{6A42000000000001}" {
     m_iOrder 1
     m_sTitle "RICH TEXT SHOWCASE"
     m_sContent "<h1 align=\"center\">RICH TEXT SHOWCASE</h1><b>PLAIN:</b> Regular unformatted text<br /><b>BOLD:</b> <b>Bold text</b><br /><b>ITALIC:</b> <i>Italic text</i><br /><b>BOLD + ITALIC:</b> <b><i>Bold italic text</i></b><br /><b>COLOR NAME:</b> <color name=\"orange\">Orange by name</color><br /><b>COLOR RGBA:</b> <color rgba=\"0,180,255,255\">Blue by RGBA</color><br /><b>COLOR HEX:</b> <color hex=\"0xFFFF6600\">Orange by hex</color><br /><b>OUTLINE:</b> <outline color=\"255,128,0,255\" size=\"2\">Outlined text</outline><br /><b>SHADOW:</b> <shadow color=\"0,0,0\" size=\"2\" offset=\"2,2\" opacity=\"0.8\">Shadowed text</shadow><br /><b>FONT:</b> <font name=\"{D3E75BCBECEB273E}UI/Fonts/NotoSans/NotoSans-Enhanced-Regular-JP-KOR-SC-LAT.fnt\" force=1>Alternate NotoSans font</font><br /><p align=\"left\"><b>PARAGRAPH LEFT:</b> Left aligned</p><p align=\"center\"><b>PARAGRAPH CENTER:</b> Center aligned</p><p align=\"right\"><b>PARAGRAPH RIGHT:</b> Right aligned</p><h align=\"left\" scale=\"1.25\">HEADER SCALE: 1.25x</h><h1 align=\"left\">HEADER H1: 2x</h1><h2 align=\"left\">HEADER H2: 1.5x</h2><b>LINE BREAK:</b> First line<br />Second line<br /><b>UNICODE UCS:</b> <ucs codepoints=\"\\u2605\\u2713\" /><br /><b>NATIVE INPUT ACTION:</b> <action name=\"CharacterAction\" mode=\"text\" /><br /><b>NATIVE KEY:</b> <key name=\"gamepad0:pad_left\" mode=\"text\" /><br /><b>IMAGE:</b> <image set=\"{CB9C19A2219A4BFC}UI/Textures/Icons/Lobby_PS_Atlas_x64.imageset\" name=\"Attention\" scale=\"1\" /><p>ACTION: <action id=\"debug_print\"><color name=\"orange\"><b>click to print</b></color></action> | MARKER: <marker name=\"Alpha\"><color name=\"orange\"><b>marker Alpha</b></color></marker> | UNDERLINE: <u>underlined</u> | STRIKE S: <s>struck with s</s> | STRIKE ALIAS: <strike>struck with strike</strike> | SIZE: <size scale=\"1.35\">1.35x text</size> | COMBINED: <size scale=\"1.25\"><u><s><color name=\"orange\"><b><i>size underline strike color bold italic</i></b></color></s></u></size></p>"
    }
    GC_Briefing "{6A42000000000002}" {
     m_iOrder 2
     m_sTitle "SITUATION"
     m_sContent "<p>Enemy forces control several strategically important positions and are prepared to reinforce them. Future map focus can reference <marker name=\"Alpha\"><color name=\"orange\"><b>marker Alpha</b></color></marker> by its authored name.</p><p>Friendly elements are assembling in protected staging areas. Reconnaissance is limited, so unit leaders should confirm routes before movement.</p><br /><color rgba=\"255,152,50,255\"><b>COMMANDER'S NOTE</b></color><br />Maintain communications, identify targets before engagement, and report meaningful changes in enemy disposition."
    }
    GC_Briefing "{6A42000000000003}" {
     m_iOrder 3
     m_sTitle "MISSION"
     m_sContent "<p>Formatting proof: <u><b>bold underline</b></u>, <s><i>italic strikethrough</i></s>, and <size scale=\"1.35\"><u><color name=\"orange\">larger orange underline</color></u></size>.</p><p>Friendly forces will seize the designated objectives, prevent an organized enemy counterattack, and establish control of the area.</p><p>Leaders retain freedom of maneuver within their assigned tasks. Coordinate supporting fires and avoid isolating individual groups.</p><br /><color rgba=\"255,152,50,255\"><b>END STATE</b></color><br />All required objectives are secure, enemy combat effectiveness is reduced, and friendly forces are prepared for follow-on operations."
    }
    GC_Briefing "{6A42000000000004}" {
     m_iOrder 4
     m_sTitle "OBJECTIVES"
     m_sContent "<color rgba=\"255,152,50,255\"><b>PRIMARY OBJECTIVES</b></color><br /><br /><b>01</b>  Secure the assigned area of operations.<br /><br /><b>02</b>  Disrupt enemy command and reinforcement routes.<br /><br /><b>03</b>  Retain sufficient combat power to hold captured positions.<br /><br /><color rgba=\"150,160,164,255\">Additional objectives may be issued by mission leadership as the situation develops.</color>"
    }
   }
  }
