SizeLayoutWidgetClass {
 Name "BriefingScenarioRow"
 Slot LayoutSlot {
  HorizontalAlign 3
  Padding 0 4 0 4
 }
 AllowHeightOverride 1
 HeightOverride 80
 {
  HorizontalLayoutWidgetClass {
   Name "BriefingScenarioRowContent"
   Slot AlignableSlot {
    HorizontalAlign 3
    VerticalAlign 3
   }
   {
    SizeLayoutWidgetClass {
     Name "BriefingScenarioIconSize"
     Slot LayoutSlot {
      VerticalAlign 3
     }
     AllowWidthOverride 1
     WidthOverride 68
     {
      ImageWidgetClass {
       Name "BriefingScenarioIcon"
       Slot AlignableSlot {
        HorizontalAlign 1
        VerticalAlign 1
       }
       Color 1 0.816 0.251 1
       Size 44 44
      }
     }
    }
    RichTextWidgetClass {
     Name "BriefingScenarioText"
     Slot LayoutSlot {
      VerticalAlign 3
      Padding 8 0 4 0
      SizeMode Fill
     }
     Color 0.839 0.839 0.839 1
     Text "SCENARIO PARAMETER"
     "Font Size" 21
     "Min Font Size" 18
     "Vertical Alignment" Center
     Wrap 1
    }
   }
  }
 }
}
