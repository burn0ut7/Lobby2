SizeLayoutWidgetClass {
       Name "CheckboxSquare"
       Slot OverlayWidgetSlot { HorizontalAlign 0 VerticalAlign 1 Padding 12 0 0 0 }
       AllowWidthOverride 1
       WidthOverride 24
       AllowHeightOverride 1
       HeightOverride 24
       "Ignore Cursor" 1
       {
        OverlayWidgetClass {
         Slot AlignableSlot { HorizontalAlign 3 VerticalAlign 3 }
         "Ignore Cursor" 1
         {
          PanelWidgetClass {
           Slot OverlayWidgetSlot { HorizontalAlign 3 VerticalAlign 3 }
           Color 0 0 0 0.45
           style full
           "Ignore Cursor" 1
          }
          PanelWidgetClass {
           Slot OverlayWidgetSlot { HorizontalAlign 3 VerticalAlign 3 }
           Color 1 1 1 0.55
           style outline_2px
           "Ignore Cursor" 1
          }
          SizeLayoutWidgetClass {
           Slot OverlayWidgetSlot { HorizontalAlign 1 VerticalAlign 1 }
           AllowWidthOverride 1
           WidthOverride 16
           AllowHeightOverride 1
           HeightOverride 16
           "Ignore Cursor" 1
           {
            PanelWidgetClass {
             Name "Tick"
             Slot AlignableSlot { HorizontalAlign 3 VerticalAlign 3 }
             Color 0.95 0.73 0.3 1
             style full
             "Is Visible" 0
             "Ignore Cursor" 1
            }
           }
          }
         }
        }
       }
      }
