     }
     Text "STAGING"
     "Font Size" 24
     FontProperties FontProperties {
      Font "UI/Fonts/Roboto/Roboto_Bold.fnt"
     }
     Color 1 1 1 1
     "Horizontal Alignment" Left
     "Vertical Alignment" Center
     "Ignore Cursor" 1
    }
    TextWidgetClass {
     Name "StagingCountdownTime"
     Slot FrameWidgetSlot {
      Anchor 0.6 0 1 1
