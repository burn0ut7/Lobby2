FrameWidgetClass {
 Name "LobbyStagingCountdown"
 "Z Order" 10000
 "Ignore Cursor" 1
 {
  FrameWidgetClass {
   Name "StagingCountdownCard"
   Slot FrameWidgetSlot {
    Anchor 0.5 0 0.5 0
    OffsetLeft 0
    OffsetTop 28
    SizeX 324
    OffsetRight -324
    SizeY 44
    OffsetBottom -72
    Alignment 0.5 0
   }
   "Ignore Cursor" 1
   {
    PanelWidgetClass {
     Name "StagingCountdownBackground"
     Slot FrameWidgetSlot {
      Anchor 0 0 1 1
      OffsetLeft 0
      OffsetTop 0
      OffsetRight 0
      OffsetBottom 0
     }
     Color 0 0 0 0.78
     style full
     "Ignore Cursor" 1
    }
    TextWidgetClass {
     Name "StagingCountdownTitle"
     Slot FrameWidgetSlot {
      Anchor 0 0 0.6 1
      OffsetLeft 12
