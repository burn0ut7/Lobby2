      OffsetTop 0
      OffsetRight 12
      OffsetBottom 0
     }
     Text "00:00"
     "Font Size" 28
     FontProperties FontProperties {
      Font "UI/Fonts/Roboto/Roboto_Bold.fnt"
     }
     Color 1 1 1 1
     "Horizontal Alignment" Right
     "Vertical Alignment" Center
     "Ignore Cursor" 1
    }
   }
  }
 }
